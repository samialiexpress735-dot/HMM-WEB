+                              disabled={full || eligible.length === 0}
+                              className={`${inputCls} disabled:bg-slate-100 disabled:text-slate-400`}
+                            >
+                              <option value="">
+                                {full
+                                  ? T('No seats free', 'ባዶ መቀመጫ የለም')
+                                  : eligible.length === 0
+                                  ? T('No one is waiting', 'የሚጠብቅ የለም')
