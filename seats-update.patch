+                              className="shrink-0 rounded-xl bg-emerald-600 px-3.5 text-xs font-bold text-white transition-colors hover:bg-emerald-700 disabled:cursor-not-allowed disabled:opacity-40 cursor-pointer"
+                            >
+                              {T('Save', 'አስቀምጥ')}
+                            </button>
